@startuml
title Implemented artillery calculation flow and separate Normal Shooting route
autonumber
actor User
participant "app.py" as App
participant "Normal view/controller/model" as Normal
participant "Artillery View" as View
participant "Artillery Controller" as Controller
participant "calculate_artillery" as Resolver
participant "ArtilleryRulesRegistry" as Registry

User -> App : choose calculator
alt Normal Shooting
  App -> Normal : render inputs / calculate / render results
  Normal --> App : legacy abstract CombatResult
else Artillery Shooting
  App -> View : render_page()
  View -> Registry : available_unit_rules(nation, initial_range_in)
  Registry --> View : generic rule options
  User -> View : enter Unit roster, values, horizon, options
  View -> Controller : calculate_artillery_use_case(command, registry)
  Controller -> Resolver : calculate_artillery(command, registry)
  Resolver -> Registry : for_nation(shooting_nation)
  Registry --> Resolver : NationArtilleryRules policy
  Resolver -> Resolver : exact state distribution for Shooting #1
  loop each later shooting through bounded horizon
    Resolver -> Resolver : Starting Step: Rally → Unit Last Stand → Formation Last Stand
    Resolver -> Resolver : exact Repeat Bombardment transitions
    Resolver -> Resolver : aggregate per-shooting metrics/distribution
  end
  Resolver --> Controller : ArtilleryResult(shootings)
  Controller --> View : ArtilleryResult
  View --> User : exact per-shooting results + scope limitations
end
@enduml
